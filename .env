# Path to the vanilla directory (relative to repo or absolute)
VANILLA_DIR="../vanilla"

# Previous version (reference to compare against)
PREVIOUS_VERSION="2.05.00"

# New version (target directory for unpacking)
NEW_VERSION="2.05.01"

# Path to the Steam PAMT file and file filter
PAMT_PATH="$HOME/.local/share/Steam/steamapps/common/Crimson Desert/0012/0.pamt"
FILTER="inputmap*.xml"
